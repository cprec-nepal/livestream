# ============================================================
# livestream-proctor — example configuration
# Copy to .env and fill in real values. NEVER commit .env.
# (This file contains PLACEHOLDERS ONLY — no real secrets.)
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy (Render, Caddy, nginx)
# so rate limiting keys on the real client IP via X-Forwarded-For.
TRUST_PROXY=false

# Optional: serve HTTPS directly (useful for phone access on a LAN
# without a reverse proxy). Paths to PEM files. Leave empty for http.
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem

# --- LiveKit (server-side only — never expose these to the browser) ---
# Get these from your LiveKit Cloud dashboard (livekit.cloud).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET

# --- Admin dashboard auth (hashed password) ---
# ADMIN_PASSWORD_HASH is the SHA-256 hex digest of the admin password.
# Generate one with:
#   echo -n "your-strong-password" | sha256sum
# (use a password of at least 12 characters)
ADMIN_PASSWORD_HASH=REPLACE_WITH_SHA256_HEX_DIGEST
# Secret used to sign the admin_session JWT cookie (min 32 chars).
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
ADMIN_COOKIE_TTL_HOURS=8

# --- CORS ---
# Comma-separated allowlist of origins, or * for development.
# In production set the exact HTTPS origin, e.g.:
#   CORS_ORIGIN=https://livestream.cprecnepal.org.np
CORS_ORIGIN=*

# --- Session limits & proctoring telemetry ---
MAX_PARTICIPANTS_PER_ROOM=50
TAB_HIDDEN_ALERT_THRESHOLD_MS=10000
SNAPSHOT_INTERVAL_MS=30000
