# ============================================================
# livestream-proctor — example configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy (Render, Caddy, nginx)
# so rate limiting keys on the real client IP via X-Forwarded-For.
TRUST_PROXY=false

# --- LiveKit (server-side only — never expose these to the browser) ---
LIVEKIT_URL=wss://your-livekit-server.example.com
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- Admin dashboard auth (v1.2: hashed password) ---
# ADMIN_PASSWORD_HASH is the SHA-256 hex digest of the admin password.
# Generate one with:
#   echo -n "your-strong-password" | sha256sum
# (use a password of at least 12 characters)
ADMIN_PASSWORD_HASH=REPLACE_WITH_SHA256_HASH_OF_PASSWORD
# Secret used to sign the admin_session JWT cookie (min 32 chars).
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
ADMIN_COOKIE_TTL_HOURS=8

# --- CORS ---
# Comma-separated allowlist of origins, or * for development.
# In production set the exact HTTPS origin, e.g. https://sessions.example.org
CORS_ORIGIN=*

# --- Session limits & proctoring telemetry ---
MAX_PARTICIPANTS_PER_ROOM=50
TAB_HIDDEN_ALERT_THRESHOLD_MS=10000
SNAPSHOT_INTERVAL_MS=30000
