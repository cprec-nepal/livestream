# Local server
NODE_ENV=development
PORT=3000

# LiveKit Cloud or your self-hosted LiveKit server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-livekit-api-key
LIVEKIT_API_SECRET=replace-with-your-livekit-api-secret

# Admin dashboard credentials
# Generate unique values with:
#   openssl rand -hex 16  # ADMIN_PASSWORD
#   openssl rand -hex 32  # ADMIN_JWT_SECRET
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_COOKIE_TTL_HOURS=8

# Use a comma-separated allowlist for multiple production origins.
# Never include paths, trailing slashes, or wildcards in an origin.
CORS_ORIGIN=http://localhost:3000

# Session limits and telemetry
MAX_PARTICIPANTS_PER_ROOM=50
TAB_HIDDEN_ALERT_THRESHOLD_MS=10000
