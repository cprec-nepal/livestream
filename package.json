{
  "name": "livestream-proctor",
  "version": "1.2.0",
  "description": "Mobile-optimized WebRTC (LiveKit) online session platform with lightweight proctoring telemetry",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js",
    "test": "bash test.sh",
    "healthcheck": "node -e \"fetch('http://localhost:'+(process.env.PORT||3000)+'/health').then(r=>r.json()).then(j=>console.log(j)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "keywords": [
    "webrtc",
    "livekit",
    "proctoring",
    "online-session",
    "education",
    "telemetry",
    "mobile"
  ],
  "author": "CPREC Nepal",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.1.3",
    "socket.io": "^4.7.5"
  }
}
